# Cadena de conexión a MongoDB Atlas (reemplaza usuario, password y cluster)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/diario-gamer?retryWrites=true&w=majority

# Puerto del servidor (Render asigna el suyo automáticamente)
PORT=3000

# Origen(es) permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# "production" en Render: oculta el stack de los errores 500 y desactiva /api/debug/error
NODE_ENV=development

# E2 no agrega variables nuevas: la zona horaria (America/Guayaquil) es una regla de negocio fija, no configuración.
